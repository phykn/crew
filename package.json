{
  "name": "crew",
  "productName": "crew",
  "version": "1.8.8",
  "private": true,
  "description": "비서 한 명에게 맡기고 AI 에이전트 팀의 일을 픽셀 캠프에서 지켜보는 데스크톱 앱",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "kwangnam.yu"
  },
  "main": ".vite/build/index.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package:mac": "electron-forge make --platform darwin --arch arm64 --targets @electron-forge/maker-zip",
    "make:mac": "electron-forge make --platform darwin --arch arm64",
    "test": "vitest run --project unit",
    "test:e2e": "electron-forge package && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "test:live": "vitest run --project live",
    "demo": "electron-forge package && node demo/make.mjs",
    "demo:en": "electron-forge package && node demo/make.mjs --lang en"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-pkg": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.4",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.94.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.327",
    "@pixi/react": "^8.0.5",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@xyflow/react": "12.12.1",
    "diff": "^9.0.0",
    "galmuri": "2.40.3",
    "gsap": "^3.15.1",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xstate": "^5.33.4",
    "zod": "^4.6.7"
  }
}
